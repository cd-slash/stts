{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stts-bff",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "vars": {
    "AUTH_MODE": "access",
    "SPEECH_MODE": "live",
    "AGENT_MODE": "hermes",
    "HERMES_BASE_URL": "https://hermes.cdslash.com",
    "HERMES_TIMEOUT_MS": "15000",
    "HERMES_TURN_TIMEOUT_MS": "110000",
    "SPEECH_BASE_URL": "https://speech.cdslash.com",
    "SPEECH_TIMEOUT_MS": "60000"
  }
}
