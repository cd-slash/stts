{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stts-bff",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "routes": [
    { "pattern": "stts.cdslash.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AUTH_MODE": "access",
    "SPEECH_MODE": "live",
    "AGENT_MODE": "hermes",
    "HERMES_BASE_URL": "https://hermes.cdslash.com",
    "HERMES_TIMEOUT_MS": "15000",
    "HERMES_TURN_TIMEOUT_MS": "110000",
    "RESPONSE_TOKEN_TTL_SECONDS": "900",
    "SPEECH_BASE_URL": "https://speech.cdslash.com",
    "SPEECH_TIMEOUT_MS": "60000"
  }
}
